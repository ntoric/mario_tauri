# Database Configuration
DB_HOST=pgbouncer
DB_PORT=6432
DB_NAME=cafe
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production

# Encryption key for credentials stored in global_settings (e.g. Cashfree
# app id / secret key saved from Developer Settings). Falls back to
# JWT_SECRET when unset — set it to keep encryption stable across a JWT
# secret rotation.
ENCRYPTION_KEY=

# Server Configuration
PORT=8088
NODE_ENV=production

# Superadmin Configuration
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin123
SUPERADMIN_NAME=Super Administrator

# Cashfree Payment Gateway (store plan payments)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox or production
CASHFREE_ENV=sandbox
# Optional redirect URL after payment + public webhook URL for this backend
CASHFREE_RETURN_URL=
CASHFREE_NOTIFY_URL=
